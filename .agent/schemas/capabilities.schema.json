{
  "schemaVersion": 1,
  "description": "Lightweight documentation schema for .agent/capabilities.json. Enforced by scripts/agent/check-capabilities.mjs.",
  "requiredTopLevelFields": [
    "schemaVersion",
    "purpose",
    "maturityLevels",
    "capabilities"
  ],
  "requiredCapabilityFields": [
    "id",
    "name",
    "maturity",
    "taskClass",
    "linkedSkills",
    "purpose",
    "inputs",
    "outputs",
    "gates",
    "playwrightTouchpoints",
    "improvementBacklog"
  ],
  "allowedMaturityLevels": [
    "draft",
    "lab-reusable",
    "book-ready",
    "final-proof-ready"
  ]
}
